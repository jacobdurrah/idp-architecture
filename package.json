{
  "name": "idp-architecture",
  "version": "1.0.0",
  "private": true,
  "description": "IDP architecture posters + the tests that guard them",
  "type": "module",
  "scripts": {
    "serve": "serve -l 5050 .",
    "build:catalog": "node tools/build-catalog.js",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\" \"tests/contract/*.test.mjs\"",
    "test:catalog": "node --test tests/unit/catalog.test.mjs",
    "test:contract": "node --test \"tests/contract/*.test.mjs\"",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "serve": "^14.2.3"
  }
}
