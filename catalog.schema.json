{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jacobdurrah.github.io/idp-architecture/catalog.schema.json",
  "title": "IDP guide catalog",
  "description": "Machine-checkable form of the §7.1 catalog contract. Grows additively: new fields are optional, existing names are never removed.",
  "type": "object",
  "required": ["schemaVersion", "version", "records"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "description": "Contract version of the catalog shape (semver). Bumped only on an additive schema change."
    },
    "version": {
      "type": "string",
      "description": "Content hash of the record payload; changes only when the records change, busting the agent's cache."
    },
    "records": {
      "type": "array",
      "items": { "$ref": "#/$defs/record" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "record": {
      "type": "object",
      "required": ["id", "tab", "name", "what", "why", "href"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "tab": {
          "type": "string",
          "enum": ["golden", "v2", "agents", "metal", "map", "scenarios"]
        },
        "name": { "type": "string", "minLength": 1 },
        "what": { "type": "string", "minLength": 1 },
        "why": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "minLength": 1 },
        "plane": { "type": "string" },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "medium": { "type": "string" },
        "speed": { "type": "string" },
        "latency": { "type": "string" },
        "bandwidth": { "type": "string" },
        "owner": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["box", "sequence", "step"]
        },
        "badge": { "type": "number" },
        "tech": {
          "type": "array",
          "items": { "type": "string" }
        },
        "seq": { "type": "object" }
      },
      "additionalProperties": true
    }
  }
}
